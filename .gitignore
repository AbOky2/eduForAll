# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Secrets de signature et de store — ils vivent dans EAS (expo.dev →
# Credentials) ou dans les secrets GitHub, jamais dans le dépôt.
# scripts/tools/eas-release.sh refuse aussi de construire si l'un d'eux est suivi.
*.keystore
*.cer
*.certSigningRequest
AuthKey_*.p8
# Clé JSON d'un compte de service Google (Play Console, envoi par EAS Submit)
*service-account*.json
*service_account*.json
*serviceaccount*.json
*play-console*.json
*play_console*.json
*play-store*.json
*play_store*.json
google-play-key*.json
pc-api-*.json
api-*-*-*.json
# Identifiants locaux d'EAS (mode « credentials.json »)
credentials.json
credentials/
# Jetons écrits par erreur dans un fichier
.expo-token
*.token

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# typescript
*.tsbuildinfo

example

# generated native folders
/ios
/android

# Chaîne voix locale (Kokoro) — outillage de build, jamais livré
.venv-audio/
.cache/

# Python
__pycache__/
