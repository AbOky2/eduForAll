{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "ECOLNA_ANDROID_PACKAGE": "td.ecolna.app.dev",
        "ECOLNA_IOS_BUNDLE_ID": "td.ecolna.app.dev"
      }
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "ios": {
        "simulator": false
      },
      "env": {
        "ECOLNA_ANDROID_PACKAGE": "td.ecolna.app.preview",
        "ECOLNA_IOS_BUNDLE_ID": "td.ecolna.app.preview",
        "ECOLNA_RELEASE": "1"
      }
    },
    "production": {
      "autoIncrement": true,
      "android": {
        "buildType": "app-bundle"
      },
      "env": {
        "ECOLNA_ANDROID_PACKAGE": "td.ecolna.app",
        "ECOLNA_IOS_BUNDLE_ID": "td.ecolna.app",
        "ECOLNA_RELEASE": "1"
      }
    },
    "production-apk": {
      "extends": "production",
      "autoIncrement": true,
      "android": {
        "buildType": "apk"
      }
    }
  },
  "submit": {
    "production": {
      "android": {
        "track": "internal",
        "releaseStatus": "draft"
      },
      "ios": {
        "language": "fr-FR"
      }
    }
  }
}
